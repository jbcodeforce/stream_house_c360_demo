# Sink selection: postgres (default) | kafka
SINK=postgres

# Path of the dotenv file to load (set as a real environment variable, not in
# this file). Defaults to ".env" in the working directory.
#   ENV_CONFIG_FILE=/path/to/my.env

# CDC ownership of Kafka. Leave false for local mode (no connector): the backend
# may dual-write Debezium-shaped events to cdc.public.* when
# KAFKA_PRODUCE_ENABLED is true. Set true for RDS / remote PostgreSQL,
# where the managed Debezium CDC connector publishes those topics — then the
# backend never emits, to avoid double-publishing. This overrides
# KAFKA_PRODUCE_ENABLED. (scripts/set_env_from_tf.sh exports this as true automatically.)
CDC_CONNECTOR_ENABLED=false

# Dual-write Debezium-shaped events to Kafka after each DB change (postgres sink).
KAFKA_PRODUCE_ENABLED=false

# On startup, publish every record loaded from the seed CSVs to the Kafka
# cdc.public.* topics as Debezium "create" events. Ignored when
# CDC_CONNECTOR_ENABLED is true. Requires the KAFKA_*/SCHEMA_REGISTRY_* settings.
KAFKA_SEED_ON_START=false
# --- Assistant chat -----------------------------------------------------------
# Greeting shown in the Assistant page's empty state, served by
# GET /api/v1/chat/welcome. Change it to confirm the backend value reaches the
# frontend (config propagation check) on first connection.
CHAT_FIRST_PROMPT=Hi, Jerome
# Reply provider: stub (default, canned text, no LLM) | live (agno agent over a
# local LLM + the RTCE context-engine MCP server). A "live" request with missing
# LLM/MCP config below degrades to the stub reply.
CHAT_DATA_MODE=stub
# When true, each live chat turn is also recorded on the agent_conversations
# topic (request + response as two linked Avro events) for downstream Flink
# intent analysis. Best-effort: a Kafka failure never breaks the reply. Needs
# the KAFKA_* / SCHEMA_REGISTRY_* coordinates below; the topic is created by
# Terraform (IaC/ccloud/topics.tf), the value schema registered at runtime.
CHAT_PRODUCE_CONVERSATIONS=false
# Local OpenAI-compatible LLM (e.g. an MLX server) used in live mode.
LLM_BASE_URL=http://127.0.0.1:7999/v1
LLM_MODEL=Ornith-1.5-9B-MLX-8bit
LLM_API_KEY=local-key
LLM_TEMPERATURE=0.2
# The RTCE context-engine MCP server URL is DERIVED at runtime from the Confluent
# coordinates — CLOUD_REGION, CLOUD_PROVIDER, FLINK_ORG_ID, FLINK_ENV_ID,
# KAFKA_CLUSTER_ID (set below) — and authenticates with CONFLUENT_GLOBAL_KEY/
# SECRET. There is no RTCE_MCP_URL to set; fill those coordinates and it works.
# --- C360 analytics dashboard -------------------------------------------------
# Snapshot-row provider for the Analytics page: mock (default, deterministic
# fixture — the demo runs with no infra) | live (runs a Flink SQL snapshot query
# against fct_c360_profile on Confluent Cloud).
#ANALYTICS_DATA_MODE=mock
ANALYTICS_DATA_MODE=live
# Row cap for the live snapshot SELECT (fct_c360_profile is one row per customer).
ANALYTICS_SNAPSHOT_LIMIT=50000

# ── Local development ─────────────────────────────────────────────────────────
# Copy .env.local for a ready-to-use config targeting the local Docker container:
#   cp .env.local .env
#   ./start_local_pg_server.sh   # start container
#   uv run uvicorn main:app --reload

# PostgreSQL connection (required when SINK=postgres)
# Local container default (start_local_pg_server.sh):
#   DATABASE_URL=postgresql://dbadmin:localdevonly@localhost:5432/c360db

DATABASE_URL=postgresql://dbadmin:password@localhost:5432/c360db
# RDS (production):
# DATABASE_URL=postgresql://dbadmin:password@localhost:5432/c360db
# Confluent Kafka (required when SINK=kafka)
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-west-2.aws.confluent.cloud:9092
# Kafka cluster API key/secret (different from Schema Registry credentials)
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret
KAFKA_TOPIC_CUSTOMERS=cdc.public.customers
KAFKA_TOPIC_ACCOUNTS=cdc.public.accounts
KAFKA_TOPIC_TRANSACTIONS=cdc.public.transactions
KAFKA_TOPIC_AGENT_CONVERSATIONS=agent_conversations
KAFKA_CLUSTER_NAME=

SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-west-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your_sr_api_key
SCHEMA_REGISTRY_API_SECRET=your_sr_api_secret


# ── Data Products graph page ──────────────────────────────────────────────────
# Status/metrics provider: mock (default, deterministic fixtures) | mock-lag
# (fixtures with one lagging statement) | live (Confluent Cloud + Flink).
#GRAPH_DATA_MODE=mock
GRAPH_DATA_MODE=live

CLOUD_PROVIDER=aws
CLOUD_REGION=us-west-2
# Live mode only (GRAPH_DATA_MODE=live) — Confluent Cloud Metrics API credentials.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=
# Live mode only — Flink SQL Statements API credentials.
FLINK_API_KEY=
FLINK_API_SECRET=
# Live mode only — Flink organization id for the Statements API path.
FLINK_ORG_ID=
# Live mode only — Flink environment id for the Statements API path.
FLINK_ENV_ID=
# Live mode only — Flink compute pool id used to scope Metrics API queries
# (the c360 / default pool).
FLINK_COMPUTE_POOL_ID=
# Live mode only — second Flink compute pool backing the crm data product. dbt
# routes crm models here; the Cost API sums billed CFUs per pool for the pipeline
# cost banner. Sourced from Terraform output flink_crm_compute_pool_id.
FLINK_CRM_COMPUTE_POOL_ID=
# Live mode only — Flink SQL Statements API base URL (region-specific).
FLINK_REST_ENDPOINT=https://flink.us-west-2.aws.confluent.cloud


# Live mode only — Flink catalog/database for the snapshot query. These are the
# Confluent Cloud ENVIRONMENT and KAFKA CLUSTER *display names* (not their ids).
# Discover them from Flink with `SHOW CATALOGS;` / `SHOW DATABASES;`.
FLINK_CATALOG=
FLINK_DATABASE=

# --- RTCE / Confluent Lightning Query API -------------------------------------
# Used by the analytics "Customer lookup via RTCE" section in live mode: a
# synchronous point-lookup serving layer that returns current state directly.
# Endpoint: https://sql.${CLOUD_REGION}.${CLOUD_PROVIDER}.confluent.cloud/query/v1alpha1
# The request is scoped by catalog_name = env *id* (FLINK_ENV_ID) and
# database_name = Kafka cluster *id* (KAFKA_CLUSTER_ID) — IDs, not display names.
# Auth needs a dedicated GLOBAL resource API key (one that authenticates the
# whole organization; a cluster/env/Flink/Metrics key returns 401). Provision it
# with IaC/ccloud/lightning.tf and read the rtce_lightning_api_key_* outputs.
KAFKA_CLUSTER_ID=
CONFLUENT_GLOBAL_KEY=
CONFLUENT_GLOBAL_SECRET=