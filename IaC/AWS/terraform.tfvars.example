# AWS Region configuration (Defaulting to AWS West)
aws_region_primary = "us-west-2"

# Project identification
environment  = "demo"
project_name = "c360"

# --- Option 1: Existing VPC & Subnets ---
# Replace with your actual existing VPC ID:
vpc_id = "vpc-0..."


# --- Accessibility & Allowed Ingress CIDRs ---
publicly_accessible = true
my_ip_addr= ""


# Allow your local machine IP and Confluent Cloud Egress IPs (never use 0.0.0.0/0)
# E.g.: ["YOUR_LOCAL_IP/32", "CONFLUENT_NAT_GW_IP_1/32", "CONFLUENT_NAT_GW_IP_2/32"]
db_allowed_cidr_blocks = [
  # "YOUR_LOCAL_IP/32",
  # "CONFLUENT_EGRESS_IP/32"
]

# --- PostgreSQL RDS Configuration ---
db_name                  = "c360db"
db_username              = "dbadmin"
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 100
