# terraform.tfvars.example
# Copy to terraform.tfvars and fill in real values.
# Do NOT commit terraform.tfvars to version control.
# Confluent Cloud service account with environment management role
cc_sa_env_mgr = "REPLACE"
# ── Confluent Cloud credentials ────────────────────────────────────────────────
# Obtain from: Confluent Cloud Console → API Keys
# (or export CONFLUENT_CLOUD_API_KEY / CONFLUENT_CLOUD_API_SECRET instead)
confluent_cloud_api_key    = "REPLACE_WITH_API_KEY"
confluent_cloud_api_secret = "REPLACE_WITH_API_SECRET"

# ── Cloud / region (Kafka cluster + Flink compute pool) ─────────────────────────
aws_region_primary = "us-west-2"

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# flink_max_cfu = 5

# NOTE: the Kafka connector and its AWS RDS dependency now live in IaC/connector/.
# This core stack provisions no AWS resources and needs no AWS credentials.
